{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lineagepilot:protocol",
  "title": "LineagePilot lineage/* protocol",
  "description": "The custom requests and notifications between the LineagePilot extension and its language server (design section 9). This file is the single source: protocol/generate.py writes the zod schemas for the extension and the dataclass validators for the server from it. Each side validates what it receives. Every request carries a params object, even an empty one (spike S1, finding 4). Free text from the workspace is truncated by the server to fit the length limits here.",
  "x-protocol-version": 1,
  "x-requests": {
    "lineage/status": { "params": "EmptyParams", "result": "Status" },
    "lineage/refresh": { "params": "EmptyParams", "result": "Status" },
    "lineage/graph": { "params": "GraphParams", "result": "GraphResult" },
    "lineage/impact": { "params": "ImpactParams", "result": "ImpactResult" },
    "lineage/export": { "params": "ExportParams", "result": "ExportResult" },
    "lineage/nodesForFile": { "params": "NodesForFileParams", "result": "NodesForFileResult" },
    "lineage/node": { "params": "NodeParams", "result": "NodeResult" },
    "lineage/reviewChanges": { "params": "ReviewParams", "result": "ReviewResult" },
    "lineage/airflow": { "params": "AirflowParams", "result": "AirflowResult" }
  },
  "x-notifications": {
    "lineage/indexUpdated": "Status"
  },
  "x-error-codes": {
    "NotReady": -32001,
    "UnknownNode": -32002,
    "ProtocolMismatch": -32003
  },
  "$defs": {
    "Id": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "Name": { "type": "string", "maxLength": 4096 },
    "Text": { "type": "string", "maxLength": 65536 },
    "Uri": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "Count": { "type": "integer", "minimum": 0 },

    "NodeKind": {
      "enum": ["model", "seed", "snapshot", "source", "exposure", "relation", "airflow_dag", "airflow_task", "column"]
    },
    "EdgeKind": { "enum": ["depends_on", "derives", "materialises", "orchestrates", "task_depends_on"] },
    "Confidence": { "enum": ["declared", "inferred", "heuristic"] },
    "Origin": { "enum": ["manifest", "compiled_sql", "catalog", "dag_static", "annotation"] },
    "Direction": { "enum": ["upstream", "downstream", "both"] },
    "Side": { "enum": ["root", "upstream", "downstream"] },
    "Granularity": { "enum": ["model", "column"] },
    "LineageState": { "enum": ["resolved", "partial", "unknown"] },
    "IndexState": { "enum": ["starting", "ready", "unknown", "failed"] },
    "ColumnStage": { "enum": ["pending", "computing", "done", "off"] },
    "ExportFormat": { "enum": ["json", "mermaid", "dot", "graphml", "cypher", "pii-markdown", "pii-csv"] },
    "AirflowStage": { "enum": ["pending", "scanning", "done", "failed"] },

    "Position": {
      "type": "object",
      "properties": { "line": { "$ref": "#/$defs/Count" }, "character": { "$ref": "#/$defs/Count" } },
      "required": ["line", "character"],
      "additionalProperties": false
    },
    "Range": {
      "type": "object",
      "properties": { "start": { "$ref": "#/$defs/Position" }, "end": { "$ref": "#/$defs/Position" } },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "Location": {
      "description": "A file to open, and where in it when known.",
      "type": "object",
      "properties": {
        "uri": { "$ref": "#/$defs/Uri" },
        "range": { "anyOf": [{ "$ref": "#/$defs/Range" }, { "type": "null" }] }
      },
      "required": ["uri", "range"],
      "additionalProperties": false
    },
    "Unknown": {
      "description": "A reference that could not be resolved, or a model whose column lineage is unknown. Shown, never dropped.",
      "type": "object",
      "properties": {
        "subject": { "$ref": "#/$defs/Id" },
        "reference": { "$ref": "#/$defs/Text" },
        "reason": { "$ref": "#/$defs/Text" }
      },
      "required": ["subject", "reference", "reason"],
      "additionalProperties": false
    },

    "EmptyParams": { "type": "object", "properties": {}, "additionalProperties": false },

    "GraphParams": {
      "type": "object",
      "properties": {
        "root": { "$ref": "#/$defs/Id", "description": "A node ID, or a column ID at column granularity." },
        "direction": { "$ref": "#/$defs/Direction" },
        "depth": { "type": "integer", "minimum": 1, "maximum": 10 },
        "granularity": { "$ref": "#/$defs/Granularity" },
        "maxNodes": { "type": "integer", "minimum": 1, "maximum": 5000 }
      },
      "required": ["root", "direction", "depth", "granularity"],
      "additionalProperties": false
    },
    "GraphNode": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "kind": { "$ref": "#/$defs/NodeKind" },
        "name": { "$ref": "#/$defs/Name" },
        "side": { "$ref": "#/$defs/Side" },
        "depth": { "$ref": "#/$defs/Count" },
        "parent": { "anyOf": [{ "$ref": "#/$defs/Id" }, { "type": "null" }], "description": "The node a column belongs to." },
        "location": { "anyOf": [{ "$ref": "#/$defs/Location" }, { "type": "null" }] },
        "layer": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "materialization": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "owner": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "description": { "anyOf": [{ "$ref": "#/$defs/Text" }, { "type": "null" }] },
        "columnLineage": { "anyOf": [{ "$ref": "#/$defs/LineageState" }, { "type": "null" }] },
        "columnLineageReason": { "anyOf": [{ "$ref": "#/$defs/Text" }, { "type": "null" }] },
        "pii": { "type": "boolean" }
      },
      "required": [
        "id", "kind", "name", "side", "depth", "parent", "location", "layer", "materialization",
        "owner", "description", "columnLineage", "columnLineageReason", "pii"
      ],
      "additionalProperties": false
    },
    "GraphEdge": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/EdgeKind" },
        "upstream": { "$ref": "#/$defs/Id" },
        "downstream": { "$ref": "#/$defs/Id" },
        "relation": {
          "anyOf": [{ "$ref": "#/$defs/Id" }, { "type": "null" }],
          "description": "The physical table between a source and the seed, model or snapshot that builds it."
        },
        "confidence": { "$ref": "#/$defs/Confidence" },
        "origins": { "type": "array", "items": { "$ref": "#/$defs/Origin" }, "maxItems": 5 },
        "transformation": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] }
      },
      "required": ["kind", "upstream", "downstream", "relation", "confidence", "origins", "transformation"],
      "additionalProperties": false
    },
    "GraphResult": {
      "type": "object",
      "properties": {
        "root": { "$ref": "#/$defs/Id" },
        "direction": { "$ref": "#/$defs/Direction" },
        "granularity": { "$ref": "#/$defs/Granularity" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/GraphNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/GraphEdge" } },
        "truncated": { "type": "boolean" },
        "unknowns": { "type": "array", "items": { "$ref": "#/$defs/Unknown" } }
      },
      "required": ["root", "direction", "granularity", "nodes", "edges", "truncated", "unknowns"],
      "additionalProperties": false
    },

    "ImpactParams": {
      "type": "object",
      "properties": {
        "targets": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "minItems": 1, "maxItems": 200 },
        "maxDepth": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "required": ["targets"],
      "additionalProperties": false
    },
    "ImpactedNode": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "kind": { "$ref": "#/$defs/NodeKind" },
        "name": { "$ref": "#/$defs/Name" },
        "depth": { "$ref": "#/$defs/Count" },
        "granularity": { "$ref": "#/$defs/Granularity" },
        "confidence": { "$ref": "#/$defs/Confidence" },
        "columns": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
        "reason": { "anyOf": [{ "$ref": "#/$defs/Text" }, { "type": "null" }] },
        "location": { "anyOf": [{ "$ref": "#/$defs/Location" }, { "type": "null" }] },
        "owner": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] }
      },
      "required": ["id", "kind", "name", "depth", "granularity", "confidence", "columns", "reason", "location", "owner"],
      "additionalProperties": false
    },
    "ImpactResult": {
      "type": "object",
      "properties": {
        "targets": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
        "truncated": { "type": "boolean" },
        "counts": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Count" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/ImpactedNode" } },
        "unknowns": { "type": "array", "items": { "$ref": "#/$defs/Unknown" } },
        "columnLineage": {
          "$ref": "#/$defs/ColumnStage",
          "description": "While computing, models not yet analysed are impacted at model level."
        }
      },
      "required": ["targets", "truncated", "counts", "nodes", "unknowns", "columnLineage"],
      "additionalProperties": false
    },

    "ExportParams": {
      "type": "object",
      "properties": {
        "format": { "$ref": "#/$defs/ExportFormat" },
        "root": { "$ref": "#/$defs/Id", "description": "Export the neighbourhood of this node; the whole graph when absent." },
        "direction": { "$ref": "#/$defs/Direction" },
        "depth": { "type": "integer", "minimum": 1, "maximum": 10 }
      },
      "required": ["format"],
      "additionalProperties": false
    },
    "ExportResult": {
      "type": "object",
      "properties": {
        "format": { "$ref": "#/$defs/ExportFormat" },
        "filename": { "$ref": "#/$defs/Name" },
        "content": { "type": "string" },
        "nodes": { "$ref": "#/$defs/Count" },
        "edges": { "$ref": "#/$defs/Count" }
      },
      "required": ["format", "filename", "content", "nodes", "edges"],
      "additionalProperties": false
    },

    "NodesForFileParams": {
      "type": "object",
      "properties": { "uri": { "$ref": "#/$defs/Uri" } },
      "required": ["uri"],
      "additionalProperties": false
    },
    "NodesForFileResult": {
      "type": "object",
      "properties": { "nodes": { "type": "array", "items": { "$ref": "#/$defs/GraphNode" } } },
      "required": ["nodes"],
      "additionalProperties": false
    },

    "NodeParams": {
      "type": "object",
      "properties": { "id": { "$ref": "#/$defs/Id", "description": "A node ID or a column ID." } },
      "required": ["id"],
      "additionalProperties": false
    },
    "ColumnInfo": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "name": { "$ref": "#/$defs/Name" },
        "dataType": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "description": { "anyOf": [{ "$ref": "#/$defs/Text" }, { "type": "null" }] },
        "pii": { "type": "boolean" },
        "tests": { "$ref": "#/$defs/Count" }
      },
      "required": ["id", "name", "dataType", "description", "pii", "tests"],
      "additionalProperties": false
    },
    "NodeResult": {
      "description": "One node or column: its details, its columns (for a node), and how many direct neighbours it has at its granularity.",
      "type": "object",
      "properties": {
        "node": { "$ref": "#/$defs/GraphNode" },
        "columns": { "type": "array", "items": { "$ref": "#/$defs/ColumnInfo" } },
        "upstream": { "$ref": "#/$defs/Count" },
        "downstream": { "$ref": "#/$defs/Count" }
      },
      "required": ["node", "columns", "upstream", "downstream"],
      "additionalProperties": false
    },

    "FileStatus": { "enum": ["added", "modified", "deleted", "renamed", "untracked"] },
    "ChangedFile": {
      "description": "A file that differs from the base. Files outside the project are counted and otherwise ignored.",
      "type": "object",
      "properties": {
        "uri": { "$ref": "#/$defs/Uri" },
        "status": { "$ref": "#/$defs/FileStatus" },
        "previousUri": { "anyOf": [{ "$ref": "#/$defs/Uri" }, { "type": "null" }], "description": "Where a renamed file was." }
      },
      "required": ["uri", "status", "previousUri"],
      "additionalProperties": false
    },
    "ReviewBaseline": {
      "description": "What the changes are compared with: the ref asked for and the commit it came to, for the record, and a baseline manifest to compare columns with.",
      "type": "object",
      "properties": {
        "ref": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "commit": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "manifestPath": {
          "anyOf": [{ "$ref": "#/$defs/Text" }, { "type": "null" }],
          "description": "Absolute, or relative to the project. Null compares columns with catalog.json."
        }
      },
      "required": ["ref", "commit", "manifestPath"],
      "additionalProperties": false
    },
    "ReviewParams": {
      "type": "object",
      "properties": {
        "changedFiles": { "type": "array", "items": { "$ref": "#/$defs/ChangedFile" }, "maxItems": 20000 },
        "baseline": { "$ref": "#/$defs/ReviewBaseline" }
      },
      "required": ["changedFiles", "baseline"],
      "additionalProperties": false
    },
    "ColumnDiffState": { "enum": ["known", "unknown", "not_compared"] },
    "BaselineKind": { "enum": ["baseline_manifest", "catalog", "none"] },
    "ColumnTypeChange": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/Name" },
        "before": { "$ref": "#/$defs/Name" },
        "after": { "$ref": "#/$defs/Name" }
      },
      "required": ["name", "before", "after"],
      "additionalProperties": false
    },
    "ColumnDiff": {
      "description": "A changed node's columns against a baseline, by name and declared type. known with nothing added or removed does not rule out a change in how a column is computed.",
      "type": "object",
      "properties": {
        "state": { "$ref": "#/$defs/ColumnDiffState" },
        "baseline": { "$ref": "#/$defs/BaselineKind" },
        "added": { "type": "array", "items": { "$ref": "#/$defs/Name" } },
        "removed": { "type": "array", "items": { "$ref": "#/$defs/Name" } },
        "typeChanged": { "type": "array", "items": { "$ref": "#/$defs/ColumnTypeChange" } },
        "stale": { "type": "boolean", "description": "The file changed after the manifest was written, so the comparison waits for dbt compile." },
        "reason": { "anyOf": [{ "$ref": "#/$defs/Text" }, { "type": "null" }] }
      },
      "required": ["state", "baseline", "added", "removed", "typeChanged", "stale", "reason"],
      "additionalProperties": false
    },
    "ReviewFile": {
      "description": "A changed file, and whether it defines the node or only describes it.",
      "type": "object",
      "properties": {
        "path": { "$ref": "#/$defs/Text" },
        "status": { "$ref": "#/$defs/FileStatus" },
        "role": { "enum": ["definition", "properties"] }
      },
      "required": ["path", "status", "role"],
      "additionalProperties": false
    },
    "ChangedNode": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "kind": { "$ref": "#/$defs/NodeKind" },
        "name": { "$ref": "#/$defs/Name" },
        "owner": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "status": { "enum": ["added", "modified", "deleted", "renamed", "untracked", "properties"] },
        "files": { "type": "array", "items": { "$ref": "#/$defs/ReviewFile" } },
        "columns": { "$ref": "#/$defs/ColumnDiff" }
      },
      "required": ["id", "kind", "name", "owner", "status", "files", "columns"],
      "additionalProperties": false
    },
    "ImpactEvidence": {
      "description": "One step that reached an impacted node or column, and what says so.",
      "type": "object",
      "properties": {
        "source": { "$ref": "#/$defs/Id" },
        "target": { "$ref": "#/$defs/Id" },
        "confidence": { "$ref": "#/$defs/Confidence" },
        "origins": { "type": "array", "items": { "$ref": "#/$defs/Origin" }, "maxItems": 5 }
      },
      "required": ["source", "target", "confidence", "origins"],
      "additionalProperties": false
    },
    "ReviewImpacted": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "kind": { "$ref": "#/$defs/NodeKind" },
        "name": { "$ref": "#/$defs/Name" },
        "owner": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "file": { "anyOf": [{ "$ref": "#/$defs/Text" }, { "type": "null" }] },
        "depth": { "$ref": "#/$defs/Count" },
        "reach": { "$ref": "#/$defs/Granularity", "description": "column: traced from a changed column. model: only known to depend on a changed node." },
        "confidence": { "$ref": "#/$defs/Confidence" },
        "origins": { "type": "array", "items": { "$ref": "#/$defs/Origin" }, "maxItems": 5 },
        "columns": { "type": "array", "items": { "$ref": "#/$defs/Name" } },
        "reason": { "anyOf": [{ "$ref": "#/$defs/Text" }, { "type": "null" }] },
        "via": { "type": "array", "items": { "$ref": "#/$defs/ImpactEvidence" }, "maxItems": 5 },
        "viaMore": { "$ref": "#/$defs/Count" },
        "airflow": { "anyOf": [{ "$ref": "#/$defs/ImpactAirflow" }, { "type": "null" }], "description": "For an Airflow task or DAG: what it has to do with the change." }
      },
      "required": ["id", "kind", "name", "owner", "file", "depth", "reach", "confidence", "origins", "columns", "reason", "via", "viaMore", "airflow"],
      "additionalProperties": false
    },
    "OwnerGroup": {
      "description": "Impacted nodes by owner: meta.owner or group. A null owner holds the nodes nobody owns.",
      "type": "object",
      "properties": {
        "owner": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/Id" } }
      },
      "required": ["owner", "nodes"],
      "additionalProperties": false
    },
    "ImpactAirflow": {
      "description": "How a task or DAG relates to a change. A Cosmos DAG or group is one link in the file; tasks holds the task ids derived for the nodes it runs.",
      "type": "object",
      "properties": {
        "dag": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "operator": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "how": { "type": "array", "items": { "$ref": "#/$defs/Name" } },
        "runs": { "type": "array", "items": { "$ref": "#/$defs/Name" } },
        "runsMore": { "$ref": "#/$defs/Count" },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/Name" } },
        "tasksMore": { "$ref": "#/$defs/Count" },
        "after": { "type": "array", "items": { "$ref": "#/$defs/Name" } },
        "notes": { "type": "array", "items": { "$ref": "#/$defs/Text" } }
      },
      "required": ["dag", "operator", "how", "runs", "runsMore", "tasks", "tasksMore", "after", "notes"],
      "additionalProperties": false
    },
    "AirflowSummary": {
      "description": "What a scan of the DAG files looked at and found. analysed is false when none was read: the review then says that, rather than that no task is impacted.",
      "type": "object",
      "properties": {
        "analysed": { "type": "boolean" },
        "reason": { "anyOf": [{ "$ref": "#/$defs/Text" }, { "type": "null" }] },
        "dagFiles": { "$ref": "#/$defs/Count" },
        "dags": { "$ref": "#/$defs/Count" },
        "tasks": { "$ref": "#/$defs/Count" },
        "links": { "$ref": "#/$defs/Count" },
        "unknowns": { "$ref": "#/$defs/Count" },
        "opaqueTasks": { "$ref": "#/$defs/Count", "description": "Tasks whose commands cannot be read and do not mention dbt: counted, not listed." },
        "folders": { "type": "array", "items": { "$ref": "#/$defs/Text" } },
        "problems": { "type": "array", "items": { "$ref": "#/$defs/Text" } }
      },
      "required": ["analysed", "reason", "dagFiles", "dags", "tasks", "links", "unknowns", "opaqueTasks", "folders", "problems"],
      "additionalProperties": false
    },
    "AirflowParams": {
      "type": "object",
      "properties": {
        "nodes": {
          "anyOf": [{ "type": "array", "items": { "$ref": "#/$defs/Id" }, "maxItems": 200 }, { "type": "null" }],
          "description": "Only the tasks that run or read these nodes; null for every DAG and task."
        }
      },
      "required": ["nodes"],
      "additionalProperties": false
    },
    "AirflowTask": {
      "description": "A task, or a DAG that is one link as a whole (a Cosmos DbtDag).",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "kind": { "$ref": "#/$defs/NodeKind" },
        "name": { "$ref": "#/$defs/Name" },
        "operator": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "owner": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "how": { "type": "array", "items": { "$ref": "#/$defs/Name" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
        "derivedTasks": { "type": "array", "items": { "$ref": "#/$defs/Name" } },
        "confidence": { "anyOf": [{ "$ref": "#/$defs/Confidence" }, { "type": "null" }] },
        "origins": { "type": "array", "items": { "$ref": "#/$defs/Origin" }, "maxItems": 5 },
        "notes": { "type": "array", "items": { "$ref": "#/$defs/Text" } },
        "location": { "anyOf": [{ "$ref": "#/$defs/Location" }, { "type": "null" }] }
      },
      "required": ["id", "kind", "name", "operator", "owner", "how", "nodes", "derivedTasks", "confidence", "origins", "notes", "location"],
      "additionalProperties": false
    },
    "AirflowDag": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "name": { "$ref": "#/$defs/Name" },
        "owner": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "location": { "anyOf": [{ "$ref": "#/$defs/Location" }, { "type": "null" }] },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/AirflowTask" } }
      },
      "required": ["id", "name", "owner", "location", "tasks"],
      "additionalProperties": false
    },
    "AirflowResult": {
      "description": "The DAGs and tasks touching some nodes, or all of them (the Airflow view).",
      "type": "object",
      "properties": {
        "stage": { "$ref": "#/$defs/AirflowStage" },
        "summary": { "$ref": "#/$defs/AirflowSummary" },
        "dags": { "type": "array", "items": { "$ref": "#/$defs/AirflowDag" } },
        "unknowns": { "type": "array", "items": { "$ref": "#/$defs/Unknown" } }
      },
      "required": ["stage", "summary", "dags", "unknowns"],
      "additionalProperties": false
    },
    "AirflowStatus": {
      "type": "object",
      "properties": {
        "stage": { "$ref": "#/$defs/AirflowStage" },
        "generation": { "$ref": "#/$defs/Count", "description": "One per scan started." },
        "summary": { "$ref": "#/$defs/AirflowSummary" }
      },
      "required": ["stage", "generation", "summary"],
      "additionalProperties": false
    },
    "OtherFile": {
      "description": "A changed file no node maps to, that cannot change one.",
      "type": "object",
      "properties": {
        "path": { "$ref": "#/$defs/Text" },
        "status": { "$ref": "#/$defs/FileStatus" }
      },
      "required": ["path", "status"],
      "additionalProperties": false
    },
    "BaselineInfo": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/Name" },
        "sha256": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "generatedAt": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "dbtVersion": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] }
      },
      "required": ["name", "sha256", "generatedAt", "dbtVersion"],
      "additionalProperties": false
    },
    "ReviewArtifacts": {
      "type": "object",
      "properties": {
        "manifestGeneratedAt": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "dbtVersion": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "baselineManifest": { "anyOf": [{ "$ref": "#/$defs/BaselineInfo" }, { "type": "null" }] }
      },
      "required": ["manifestGeneratedAt", "dbtVersion", "baselineManifest"],
      "additionalProperties": false
    },
    "ReviewBase": {
      "type": "object",
      "properties": {
        "ref": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "commit": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] }
      },
      "required": ["ref", "commit"],
      "additionalProperties": false
    },
    "ReviewSummary": {
      "type": "object",
      "properties": {
        "changedFiles": { "$ref": "#/$defs/Count" },
        "changedNodes": { "$ref": "#/$defs/Count" },
        "changedColumns": { "$ref": "#/$defs/Count" },
        "staleNodes": { "$ref": "#/$defs/Count" },
        "impacted": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Count" } },
        "impactedByColumn": { "$ref": "#/$defs/Count" },
        "unknowns": { "$ref": "#/$defs/Count" }
      },
      "required": ["changedFiles", "changedNodes", "changedColumns", "staleNodes", "impacted", "impactedByColumn", "unknowns"],
      "additionalProperties": false
    },
    "ReviewResult": {
      "description": "A Change Impact Review (design section 8). The same inputs give the same result; locations aside, it is what lineagepilot review --json prints, and markdown is what it prints without --json.",
      "type": "object",
      "properties": {
        "project": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "base": { "anyOf": [{ "$ref": "#/$defs/ReviewBase" }, { "type": "null" }] },
        "artifacts": { "$ref": "#/$defs/ReviewArtifacts" },
        "columnLineage": { "$ref": "#/$defs/ColumnStage" },
        "summary": { "$ref": "#/$defs/ReviewSummary" },
        "changedNodes": { "type": "array", "items": { "$ref": "#/$defs/ChangedNode" } },
        "impacted": { "type": "array", "items": { "$ref": "#/$defs/ReviewImpacted" } },
        "owners": { "type": "array", "items": { "$ref": "#/$defs/OwnerGroup" } },
        "airflow": { "$ref": "#/$defs/AirflowSummary" },
        "unknowns": { "type": "array", "items": { "$ref": "#/$defs/Unknown" } },
        "otherFiles": { "type": "array", "items": { "$ref": "#/$defs/OtherFile" } },
        "outsideProject": { "$ref": "#/$defs/Count" },
        "notes": { "type": "array", "items": { "$ref": "#/$defs/Text" } },
        "markdown": { "$ref": "#/$defs/Text" },
        "locations": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Location" },
          "description": "Where to open each node, by ID. Only the language server adds this: it differs per machine."
        }
      },
      "required": [
        "project", "base", "artifacts", "columnLineage", "summary", "changedNodes", "impacted", "owners",
        "airflow", "unknowns", "otherFiles", "outsideProject", "notes", "markdown", "locations"
      ],
      "additionalProperties": false
    },

    "IndexError": {
      "type": "object",
      "properties": {
        "severity": { "enum": ["error", "warning"] },
        "message": { "$ref": "#/$defs/Text" },
        "location": { "anyOf": [{ "$ref": "#/$defs/Text" }, { "type": "null" }] }
      },
      "required": ["severity", "message", "location"],
      "additionalProperties": false
    },
    "ServerInfo": {
      "type": "object",
      "properties": {
        "version": { "$ref": "#/$defs/Name" },
        "python": { "$ref": "#/$defs/Name" },
        "executable": { "$ref": "#/$defs/Text" },
        "pid": { "$ref": "#/$defs/Count" },
        "isolated": { "type": "boolean", "description": "Started with python -I, so nothing from the workspace or the user's site-packages can shadow the bundle." },
        "modules": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Text" },
          "description": "Where the key libraries were imported from, to check that the bundle is what runs."
        }
      },
      "required": ["version", "python", "executable", "pid", "isolated", "modules"],
      "additionalProperties": false
    },
    "ProjectInfo": {
      "type": "object",
      "properties": {
        "root": { "anyOf": [{ "$ref": "#/$defs/Text" }, { "type": "null" }] },
        "name": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "problems": { "type": "array", "items": { "$ref": "#/$defs/Text" }, "maxItems": 100 }
      },
      "required": ["root", "name", "problems"],
      "additionalProperties": false
    },
    "ManifestInfo": {
      "type": "object",
      "properties": {
        "path": { "$ref": "#/$defs/Text" },
        "exists": { "type": "boolean" },
        "generatedAt": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "dbtVersion": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "schemaVersion": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
        "modifiedAt": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] }
      },
      "required": ["path", "exists", "generatedAt", "dbtVersion", "schemaVersion", "modifiedAt"],
      "additionalProperties": false
    },
    "CatalogInfo": {
      "type": "object",
      "properties": {
        "path": { "$ref": "#/$defs/Text" },
        "exists": { "type": "boolean" },
        "modifiedAt": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] }
      },
      "required": ["path", "exists", "modifiedAt"],
      "additionalProperties": false
    },
    "Artifacts": {
      "type": "object",
      "properties": {
        "manifest": { "anyOf": [{ "$ref": "#/$defs/ManifestInfo" }, { "type": "null" }] },
        "catalog": { "anyOf": [{ "$ref": "#/$defs/CatalogInfo" }, { "type": "null" }] }
      },
      "required": ["manifest", "catalog"],
      "additionalProperties": false
    },
    "Counts": {
      "type": "object",
      "properties": {
        "nodes": { "$ref": "#/$defs/Count" },
        "columns": { "$ref": "#/$defs/Count" },
        "edges": { "$ref": "#/$defs/Count" },
        "unresolved": { "$ref": "#/$defs/Count" },
        "nodeKinds": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Count" } }
      },
      "required": ["nodes", "columns", "edges", "unresolved", "nodeKinds"],
      "additionalProperties": false
    },
    "ColumnStates": {
      "type": "object",
      "properties": {
        "resolved": { "$ref": "#/$defs/Count" },
        "partial": { "$ref": "#/$defs/Count" },
        "unknown": { "$ref": "#/$defs/Count" }
      },
      "required": ["resolved", "partial", "unknown"],
      "additionalProperties": false
    },
    "Stale": {
      "description": "Source files changed after the manifest was written.",
      "type": "object",
      "properties": {
        "count": { "$ref": "#/$defs/Count" },
        "examples": { "type": "array", "items": { "$ref": "#/$defs/Text" }, "maxItems": 5 }
      },
      "required": ["count", "examples"],
      "additionalProperties": false
    },
    "RulesStatus": {
      "description": "The conformance rules behind the diagnostics. In Restricted Mode only the built-in rules run.",
      "type": "object",
      "properties": {
        "pack": { "anyOf": [{ "$ref": "#/$defs/Text" }, { "type": "null" }], "description": "The rule pack file, if the project has one." },
        "packLoaded": { "type": "boolean" },
        "restricted": { "type": "boolean" },
        "problems": { "type": "array", "items": { "$ref": "#/$defs/Text" }, "maxItems": 50 },
        "findings": { "$ref": "#/$defs/Count" },
        "score": { "anyOf": [{ "type": "number", "minimum": 0, "maximum": 100 }, { "type": "null" }] },
        "coverage": { "anyOf": [{ "type": "number", "minimum": 0, "maximum": 100 }, { "type": "null" }] }
      },
      "required": ["pack", "packLoaded", "restricted", "problems", "findings", "score", "coverage"],
      "additionalProperties": false
    },
    "Status": {
      "type": "object",
      "properties": {
        "protocolVersion": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
        "server": { "$ref": "#/$defs/ServerInfo" },
        "project": { "$ref": "#/$defs/ProjectInfo" },
        "trusted": { "type": "boolean" },
        "state": { "$ref": "#/$defs/IndexState" },
        "indexing": { "type": "boolean" },
        "generation": { "$ref": "#/$defs/Count" },
        "columnLineage": { "$ref": "#/$defs/ColumnStage" },
        "message": { "anyOf": [{ "$ref": "#/$defs/Text" }, { "type": "null" }] },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/IndexError" }, "maxItems": 50 },
        "errorCount": { "$ref": "#/$defs/Count" },
        "artifacts": { "$ref": "#/$defs/Artifacts" },
        "counts": { "anyOf": [{ "$ref": "#/$defs/Counts" }, { "type": "null" }] },
        "columnStates": { "anyOf": [{ "$ref": "#/$defs/ColumnStates" }, { "type": "null" }] },
        "stale": { "$ref": "#/$defs/Stale" },
        "fromCache": { "type": "boolean" },
        "indexedAt": { "anyOf": [{ "$ref": "#/$defs/Name" }, { "type": "null" }] },
        "rules": { "$ref": "#/$defs/RulesStatus" },
        "airflow": { "$ref": "#/$defs/AirflowStatus" }
      },
      "required": [
        "protocolVersion", "server", "project", "trusted", "state", "indexing", "generation",
        "columnLineage", "message", "errors", "errorCount", "artifacts", "counts", "columnStates",
        "stale", "fromCache", "indexedAt", "rules", "airflow"
      ],
      "additionalProperties": false
    }
  }
}
