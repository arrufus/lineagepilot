# Build-time only, installed into a throwaway venv by scripts/bundle_libs.py.
#
# - pip, pinned so the venv's bundled pip is replaced by a known one.
# - setuptools: PyYAML ships no pure-Python wheel, so the bundler builds one from its
#   hash-pinned sdist with PYYAML_FORCE_LIBYAML=0 and no build isolation (spike S1).
# - hatchling: builds the lineagepilot-core and lineagepilot-lsp wheels from this
#   repository, also without build isolation.
#
# Compile with:
#   uv pip compile build-requirements.in --universal --python-version 3.10 --generate-hashes \
#     --exclude-newer 2026-10-19T00:00:00Z --no-header -o build-requirements.lock
pip>=25
setuptools>=80
hatchling>=1.25
